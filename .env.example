# Frontend (estas duas variaveis sao incorporadas ao bundle pelo Vite)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# API serverless (configure também em Vercel > Project Settings > Environment Variables)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# Opcional: backend usado pelo proxy do npm run dev
DEV_API_PROXY_TARGET=https://seu-deploy.vercel.app
